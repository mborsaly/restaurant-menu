CREATE TABLE public.dead_messages
(
    id                      BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    message_id              VARCHAR(128) NOT NULL,
    generation_time         TIMESTAMP,
    exchange_type           VARCHAR(50),
    industry                VARCHAR(50),
    fleet                   VARCHAR(50),
    classification          VARCHAR(50),
    caveat                  VARCHAR(200),
    releasable              VARCHAR(200),
    dead_messages_id        VARCHAR(128) NOT NULL,
    declared_by             CHAR(1) NOT NULL,
    attempted_url           VARCHAR(1024),
    attempted_service       VARCHAR(200),
    attempted_operation     VARCHAR(200),
    status                  VARCHAR(30) DEFAULT 'NEW',
  //  retry_count             INTEGER DEFAULT 0,
   // max_retries             INTEGER DEFAULT 5,
   // first_failure_ts        TIMESTAMP,
   // last_attempt_ts         TIMESTAMP,
   // next_retry_ts           TIMESTAMP,
    error_code              VARCHAR(100),
    short_description       VARCHAR(500),
    error_message           BYTEA,
    assigned_to             VARCHAR(100),
    investigation_status    VARCHAR(30),
    investigation_comments  BYTEA,
    investigation_error_code              VARCHAR(100),
    investigation_short_description       VARCHAR(500),
    investigation_error_message           BYTEA,
    resolved_ts             TIMESTAMP,
    payload                 BYTEA,
    created_ts              TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_ts              TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_dead_messages_message_id
    ON public.dead_messages(message_id);