{
  "functions": {
    "api/restaurant-meta.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "^/(?!welcome|menu|item|cart|checkout|confirmation)([^/]+)(?:/(.*))?$",
      "destination": "/api/restaurant-meta?seg1=$1&rest=$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
