{
  "functions": {
    "api/restaurant-meta.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/welcome/:rest*", "destination": "/index.html" },
    { "source": "/menu/:rest*", "destination": "/index.html" },
    { "source": "/item/:rest*", "destination": "/index.html" },
    { "source": "/cart/:rest*", "destination": "/index.html" },
    { "source": "/checkout/:rest*", "destination": "/index.html" },
    { "source": "/confirmation/:rest*", "destination": "/index.html" },
    { "source": "/assets/:rest*", "destination": "/assets/:rest*" },
    { "source": "/api/:rest*", "destination": "/api/:rest*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/:seg1([^/.]+)",
      "destination": "/api/restaurant-meta?seg1=:seg1"
    },
    {
      "source": "/:seg1([^/.]+)/:rest(.*)",
      "destination": "/api/restaurant-meta?seg1=:seg1&rest=:rest"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}